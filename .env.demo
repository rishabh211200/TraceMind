# ==============================================================================
# TRACEMIND DEMO ENVIRONMENT CONFIGURATION
#
# Zero-cost, deterministic, safe demo profile.
# All external AI and actuator integrations default to hermetic in-memory mock.
# ==============================================================================

ENVIRONMENT=demo
DEMO_MODE=true
LOG_LEVEL=INFO
DEBUG=false

# Port Mapping (Only Nginx is exposed on the host)
DEMO_PORT=80

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Persistence (Internal Docker bridge credentials)
POSTGRES_USER=tracemind_demo
POSTGRES_PASSWORD=tracemind_demo_secret_2026
POSTGRES_DB=tracemind_demo_db
DATABASE_URL=postgresql+asyncpg://tracemind_demo:tracemind_demo_secret_2026@postgres:5432/tracemind_demo_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=15

# Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRACES=tracemind.events.raw
KAFKA_TOPIC_ANOMALIES=tracemind.events.anomalies
KAFKA_CONSUMER_GROUP=tracemind-demo-ingestor
KAFKA_BATCH_SIZE=500
KAFKA_FLUSH_INTERVAL_MS=50

# Cryptography & Zero-Trust Security
TRACEMIND_SECRET_KEY=tracemind_demo_deterministic_secret_key_2026

# AI Analyst (Deterministic In-Memory Mock — $0.00 / Zero External API calls)
AI_PROVIDER=mock
AI_MODEL_NAME=mock-react-analyst
AI_API_KEY=
AI_TEMPERATURE=0.1

# Remediation & Actuation (Strictly In-Memory / Zero Real Network Packet Side Effects)
REMEDIATION_ACTUATOR_TYPE=in_memory

# Observability
PROMETHEUS_SCRAPE_INTERVAL=15s
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=tracemind_admin
