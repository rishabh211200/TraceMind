# ==========================================
# Alembic Database Migrator Container
# ==========================================
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
COPY pyproject.toml README.md /build/
RUN uv pip install --system --target=/install -e ".[dev,ml]"

FROM python:3.12-slim AS runtime

WORKDIR /app

RUN groupadd -g 10001 tracemind && \
    useradd -u 10001 -g tracemind -s /bin/false -m tracemind

COPY --from=builder /install /usr/local/lib/python3.12/site-packages
COPY --chown=tracemind:tracemind apps /app/apps
COPY --chown=tracemind:tracemind packages /app/packages
COPY --chown=tracemind:tracemind migrations /app/migrations
COPY --chown=tracemind:tracemind alembic.ini pyproject.toml README.md /app/

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    ENVIRONMENT=production

USER tracemind:tracemind

CMD ["python", "-m", "alembic", "upgrade", "head"]
