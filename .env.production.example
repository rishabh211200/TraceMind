# ==============================================================================
# TRACEMIND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or inject as environment variables in container orchestrator
# ==============================================================================

# General
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# API Gateway
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["https://tracemind.example.com"]

# TimescaleDB / PostgreSQL Persistence
DATABASE_URL=postgresql+asyncpg://tracemind:tracemind_secret@postgres:5432/tracemind_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30.0

# Apache Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRACES=tracemind.events.raw
KAFKA_TOPIC_ANOMALIES=tracemind.events.anomalies
KAFKA_CONSUMER_GROUP=tracemind-prod-ingestor
KAFKA_BATCH_SIZE=1000
KAFKA_FLUSH_INTERVAL_MS=50
KAFKA_AUTO_OFFSET_RESET=earliest

# Observability & Monitoring
PROMETHEUS_SCRAPE_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=tracemind_admin

# Tool-Grounded Conversational AI Analyst
AI_PROVIDER=openai
AI_MODEL_NAME=gpt-4o-mini
AI_API_KEY=your_openai_api_key_here
AI_TEMPERATURE=0.1
