# TraceMind Environment Configuration Template

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL / TimescaleDB
POSTGRES_USER=tracemind
POSTGRES_PASSWORD=tracemind_secret
POSTGRES_DB=tracemind_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tracemind:tracemind_secret@localhost:5432/tracemind_db

# Redis Caching & State
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Event Streaming (Kafka - Introduced in Milestone 5)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRACES=tracemind.events.raw
KAFKA_TOPIC_ANOMALIES=tracemind.events.anomalies

# Simulator Defaults
SIMULATOR_DEFAULT_SEED=42
SIMULATOR_DEFAULT_WORKFLOW_COUNT=1000
SIMULATOR_INCIDENT_PROBABILITY=0.05

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=tracemind-failure-prediction

# AI Analyst Provider Configuration (Provider-Agnostic)
# Options: openai | anthropic | gemini | local
AI_PROVIDER=openai
AI_MODEL_NAME=gpt-4o-mini
AI_API_KEY=your_api_key_here
AI_TEMPERATURE=0.1
